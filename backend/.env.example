# Gemini API Key (Required for AI Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Amadeus Self-Service API (Optional - Sandbox credentials)
# If omitted, application automatically runs using local high-fidelity Mock Flight Engine.
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Kiwi Tequila API (Optional - Live search engine)
# If provided, has priority over Amadeus Sandbox and Mock Engine.
KIWI_API_KEY=your_kiwi_api_key_here

# SerpAPI Google Flights (Optional - Live search engine)
# If provided, has priority over Kiwi, Amadeus, and Mock Engine.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Telegram Bot Alerts (Required for 24/7 background Telegram updates)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_personal_chat_id_here

# Turso Cloud SQLite Database (Recommended for Cloud Deployments like Render)
TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
